@page
@model TelescopeShop_.Pages.IndexModel
@{
    ViewData["Title"] = "Каталог телескопов";
}

<section class="hero">
    <h1 class="hero-title">Каталог телескопов</h1>
    <p class="hero-subtitle">
        Выберите телескоп: зеркальные, рефракторы и катадиоптрики.
        В наличии @Model.Telescopes.Count моделей.
    </p>

    <form method="get" class="filter-bar">
        <div class="filter-row">
            <input type="text"
                   name="search"
                   value="@Model.Search"
                   class="filter-input filter-input-wide"
                   placeholder="Поиск по названию (производителю)…"
                   autocomplete="off" />

            <select name="barlow" class="filter-select">
                <option value="">Линза Барлоу: все</option>
                <option value="true" selected="@(Model.Barlow == true)">Только с линзой</option>
                <option value="false" selected="@(Model.Barlow == false)">Только без линзы</option>
            </select>
        </div>

        <div class="filter-row">
            <label class="filter-group">
                <span class="filter-label">Апертура, мм</span>
                <span class="filter-range">
                    <input type="number" name="apertureMin" value="@Model.ApertureMin"
                           class="filter-input filter-number" min="0" placeholder="от" />
                    <span class="filter-sep">—</span>
                    <input type="number" name="apertureMax" value="@Model.ApertureMax"
                           class="filter-input filter-number" min="0" placeholder="до" />
                </span>
            </label>

            <label class="filter-group">
                <span class="filter-label">Фокусное, мм</span>
                <span class="filter-range">
                    <input type="number" name="focalMin" value="@Model.FocalMin"
                           class="filter-input filter-number" min="0" placeholder="от" />
                    <span class="filter-sep">—</span>
                    <input type="number" name="focalMax" value="@Model.FocalMax"
                           class="filter-input filter-number" min="0" placeholder="до" />
                </span>
            </label>
        </div>

        <div class="filter-actions">
            <button type="submit" class="filter-submit">Применить</button>
            @if (Model.HasFilters)
            {
                <a href="@Url.Page("/Index")" class="filter-reset">Сбросить фильтры</a>
            }
        </div>
    </form>
</section>

@if (Model.Telescopes.Count == 0)
{
    <div class="empty-state">
        @if (Model.HasFilters)
        {
            <p>Под заданные фильтры ничего не найдено.</p>
        }
        else
        {
            <p>В каталоге пока нет товаров.</p>
        }
    </div>
}
else
{
    <div class="catalog-grid">
        @foreach (var t in Model.Telescopes)
        {
            <article class="card">
                <div class="card-image">
                    <img src="@Url.Content($"~/Product/telescope-{t.Id}.png")"
                         alt="Телескоп @t.Manufacturer, апертура @t.Aperture мм"
                         asp-append-version="true"
                         loading="lazy" />
                </div>
                <div class="card-body">
                    <h2 class="card-title">@t.Manufacturer</h2>

                    <dl class="specs">
                        <div class="spec">
                            <dt>Апертура</dt>
                            <dd>@t.Aperture мм</dd>
                        </div>
                        <div class="spec">
                            <dt>Фокусное расстояние</dt>
                            <dd>@t.FocalLength мм</dd>
                        </div>
                        <div class="spec">
                            <dt>Высота треноги</dt>
                            <dd>@t.TripodHeight мм</dd>
                        </div>
                        <div class="spec">
                            <dt>Искатель</dt>
                            <dd>@t.Seeker</dd>
                        </div>
                        <div class="spec">
                            <dt>Линза Барлоу</dt>
                            <dd>
                                <span class="badge @(t.BarlowLensIncluded ? "badge-yes" : "badge-no")">
                                    @(t.BarlowLensIncluded ? "Да" : "Нет")
                                </span>
                            </dd>
                        </div>
                        <div class="spec">
                            <dt>Макс. увеличение</dt>
                            <dd>@t.MaximumUsefulMagnification×</dd>
                        </div>
                    </dl>
                </div>
            </article>
        }
    </div>
}
