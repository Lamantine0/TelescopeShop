@page
@model TelescopeShop.Pages.IndexModel
@{
    ViewData["Title"] = "Каталог телескопов";
}

<section class="hero">
    <h1 class="hero-title">Каталог телескопов</h1>
    <p class="hero-subtitle">
        Выберите телескоп: зеркальные, рефракторы и катадиоптрики.
        В наличии @Model.Telescopes.Count моделей.
    </p>

    <details class="filter-panel" open="@(Model.HasFilters || Model.HasSort ? "true" : null)">
        <summary class="filter-toggle">
            <span class="filter-toggle-chevron" aria-hidden="true"></span>
            <span class="filter-toggle-text">Фильтры</span>
            @if (Model.ActiveFilterCount > 0)
            {
                <span class="filter-count">@Model.ActiveFilterCount</span>
            }
        </summary>

        <form method="get" class="filter-bar">
            <div class="filter-row">
                <div class="filter-autocomplete filter-autocomplete-search">
                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           class="filter-input"
                           placeholder="Поиск по модели…"
                           autocomplete="off"
                           role="combobox"
                           aria-autocomplete="list"
                           aria-expanded="false"
                           aria-controls="search-suggestions"
                           data-manufacturer-autocomplete
                           data-source="telescope-data"
                           data-autocomplete-requires-input="true" />
                    <ul class="filter-suggestions" id="search-suggestions" role="listbox" hidden></ul>
                </div>

                <div class="filter-autocomplete">
                    <input type="text"
                           name="manufacturer"
                           value="@Model.Manufacturer"
                           class="filter-input filter-manufacturer"
                           placeholder="Фирма (начните вводить)…"
                           autocomplete="off"
                           role="combobox"
                           aria-autocomplete="list"
                           aria-expanded="false"
                           aria-controls="manufacturer-suggestions"
                            data-manufacturer-autocomplete
                            data-source="manufacturer-data" />
                    <button type="button"
                            class="filter-clear"
                            data-manufacturer-clear
                            aria-label="Очистить фирму"
                            title="Очистить"
                            hidden>×</button>
                    <ul class="filter-suggestions" id="manufacturer-suggestions" role="listbox" hidden></ul>
                </div>

                <select name="barlow" class="filter-select">
                    <option value="">Линза Барлоу: все</option>
                    <option value="true" selected="@(Model.Barlow == true)">Только с линзой</option>
                    <option value="false" selected="@(Model.Barlow == false)">Только без линзы</option>
                </select>

                <label class="filter-group filter-sort">
                    <span class="filter-label">Сортировка</span>
                    <select name="sort" class="filter-select">
                        <option value="" selected="@(!Model.HasSort)">По умолчанию</option>
                        <option value="price-asc" selected="@(Model.Sort == "price-asc")">Цена ↓</option>
                        <option value="price-desc" selected="@(Model.Sort == "price-desc")">Цена ↑</option>
                        <option value="aperture-desc" selected="@(Model.Sort == "aperture-desc")">Апертура ↑</option>
                        <option value="aperture-asc" selected="@(Model.Sort == "aperture-asc")">Апертура ↓</option>
                    </select>
                </label>
            </div>

            <div class="filter-row">
                <label class="filter-group">
                    <span class="filter-label">Апертура, мм</span>
                    <span class="filter-range">
                        <input type="number" name="apertureMin" value="@Model.ApertureMin"
                               class="filter-input filter-number" min="0" placeholder="от" />
                        <span class="filter-sep">—</span>
                        <input type="number" name="apertureMax" value="@Model.ApertureMax"
                               class="filter-input filter-number" min="0" placeholder="до" />
                    </span>
                </label>

                <label class="filter-group">
                    <span class="filter-label">Фокусное, мм</span>
                    <span class="filter-range">
                        <input type="number" name="focalMin" value="@Model.FocalMin"
                               class="filter-input filter-number" min="0" placeholder="от" />
                        <span class="filter-sep">—</span>
                        <input type="number" name="focalMax" value="@Model.FocalMax"
                               class="filter-input filter-number" min="0" placeholder="до" />
                    </span>
                </label>
            </div>

            <div class="filter-actions">
                <button type="submit" class="filter-submit">Применить</button>
                @if (Model.HasFilters)
                {
                    <a href="@Model.ClearFiltersUrl" class="filter-reset">Сбросить фильтры</a>
                }
            </div>
        </form>
    </details>
</section>

@if (Model.HasFilters)
{
    <div class="active-filters">
        <span class="active-filters-label">Активные фильтры:</span>
        @foreach (var filter in Model.ActiveFilters)
        {
            <a class="filter-chip" href="@filter.RemoveUrl" aria-label="Убрать фильтр: @filter.Label">
                <span>@filter.Label</span>
                <span class="filter-chip-remove" aria-hidden="true">×</span>
            </a>
        }
        <a class="active-filters-reset" href="@Model.ClearFiltersUrl">Сбросить все</a>
    </div>
    <p class="results-count">Найдено: @Model.Telescopes.Count</p>
}

@if (Model.Telescopes.Count == 0)
{
    <div class="empty-state">
        @if (Model.HasFilters)
        {
            <p>Под заданные фильтры ничего не найдено.</p>
        }
        else
        {
            <p>В каталоге пока нет товаров.</p>
        }
    </div>
}
else
{
    <div class="catalog-grid">
        @foreach (var t in Model.Telescopes)
        {
            <div class="card">
                <a class="card-link" asp-page="/Telescope" asp-route-id="@t.Id">
                    <div class="card-image">
                        <img asp-product-src="@t.Id"
                             alt="Телескоп @t.Manufacturer, апертура @t.Aperture мм"
                             loading="lazy" />
                    </div>
                    <div class="card-body">
                        <h2 class="card-title">@t.Manufacturer</h2>

                        <dl class="specs">
                            <div class="spec">
                                <dt>Апертура</dt>
                                <dd>@t.Aperture мм</dd>
                            </div>
                            <div class="spec">
                                <dt>Фокусное расстояние</dt>
                                <dd>@t.FocalLength мм</dd>
                            </div>
                            <div class="spec">
                                <dt>Высота треноги</dt>
                                <dd>@t.TripodHeight мм</dd>
                            </div>
                            <div class="spec">
                                <dt>Искатель</dt>
                                <dd>@t.Seeker</dd>
                            </div>
                            <div class="spec">
                                <dt>Линза Барлоу</dt>
                                <dd>
                                    <span class="badge @(t.BarlowLensIncluded ? "badge-yes" : "badge-no")">
                                        @(t.BarlowLensIncluded ? "Да" : "Нет")
                                    </span>
                                </dd>
                            </div>
                            <div class="spec">
                                <dt>Макс. увеличение</dt>
                                <dd>@t.MaximumUsefulMagnification×</dd>
                            </div>
                        </dl>

                        @if (t.Price > 0)
                        {
                            <p class="card-price">@t.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("ru-RU")) ₽</p>
                        }
                        else
                        {
                            <p class="card-price card-price-request">Цена по запросу</p>
                        }
                    </div>
                </a>

                <div class="card-actions">
                    <a class="btn-buy" asp-page="/Checkout" asp-route-id="@t.Id">Купить</a>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script type="application/json" id="manufacturer-data">@Json.Serialize(Model.Manufacturers)</script>
    <script type="application/json" id="telescope-data">@Json.Serialize(Model.TelescopeNames)</script>
    <script src="~/js/manufacturer-autocomplete.js" asp-append-version="true"></script>
}
