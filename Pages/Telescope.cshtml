@page "{id:int}"
@model TelescopeShop.Pages.TelescopeModel
@{
    var t = Model.Telescope!;
    ViewData["Title"] = $"{t.Manufacturer} — апертура {t.Aperture} мм";
}

<nav class="breadcrumb">
    <a asp-page="/Index">Каталог</a>
    <span class="breadcrumb-sep" aria-hidden="true">/</span>
    <span>@t.Manufacturer</span>
</nav>

<article class="product">
    <div class="product-media">
        <img asp-product-src="@t.Id"
             alt="@t.Manufacturer, апертура @t.Aperture мм" />

        <section class="product-gallery" id="gallery">
            <h2 class="gallery-title">Галерея</h2>
            @if (Model.Gallery.Count > 0)
            {
                <div class="gallery-thumbs">
                    @for (var i = 0; i < Model.Gallery.Count; i++)
                    {
                        <figure class="gallery-thumb">
                            <a class="gallery-zoom" href="#gallery-photo-@(i + 1)"
                               aria-label="Открыть фото @(i + 1) во весь экран">
                                <img src="@Url.Content(Model.Gallery[i])"
                                     alt="@t.Manufacturer — галерея, фото @(i + 1)"
                                     asp-append-version="true"
                                     loading="lazy" />
                            </a>
                        </figure>
                    }
                </div>
            }
            else
            {
                <div class="gallery-thumbs">
                    <figure class="gallery-thumb">Фото 1</figure>
                    <figure class="gallery-thumb">Фото 2</figure>
                </div>
            }
        </section>

        @for (var i = 0; i < Model.Gallery.Count; i++)
        {
            <div id="gallery-photo-@(i + 1)" class="lightbox">
                <a class="lightbox-backdrop" href="#gallery" aria-label="Закрыть просмотр"></a>
                <img class="lightbox-img" src="@Url.Content(Model.Gallery[i])"
                     alt="@t.Manufacturer — галерея, фото @(i + 1)"
                     asp-append-version="true" />
                <a class="lightbox-close" href="#gallery" aria-label="Закрыть">&times;</a>
                <span class="lightbox-caption">Фото @(i + 1) из @Model.Gallery.Count</span>
            </div>
        }
    </div>

    <div class="product-info">
        <h1 class="product-title">@t.Manufacturer</h1>
        <p class="product-subtitle">
            @t.Aperture мм · f/@t.FocalLength мм
            <span class="badge @(t.BarlowLensIncluded ? "badge-yes" : "badge-no")">
                Линза Барлоу: @(t.BarlowLensIncluded ? "в комплекте" : "не в комплекте")
            </span>
        </p>

        <div class="product-buy">
            @if (t.Price > 0)
            {
                <span class="product-price">@t.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("ru-RU")) ₽</span>
            }
            else
            {
                <span class="product-price product-price-request">Цена по запросу</span>
            }
            <a class="btn-buy" asp-page="/Checkout" asp-route-id="@t.Id">Купить</a>
        </div>

        <dl class="product-specs">
            <div class="product-spec">
                <dt>Апертура</dt>
                <dd>@t.Aperture мм</dd>
            </div>
            <div class="product-spec">
                <dt>Фокусное расстояние</dt>
                <dd>@t.FocalLength мм</dd>
            </div>
            <div class="product-spec">
                <dt>Высота треноги</dt>
                <dd>@t.TripodHeight мм</dd>
            </div>
            <div class="product-spec">
                <dt>Искатель</dt>
                <dd>@t.Seeker</dd>
            </div>
            <div class="product-spec">
                <dt>Линза Барлоу</dt>
                <dd>@(t.BarlowLensIncluded ? "Да" : "Нет")</dd>
            </div>
            <div class="product-spec">
                <dt>Макс. полезное увеличение</dt>
                <dd>@t.MaximumUsefulMagnification×</dd>
            </div>
        </dl>

        <section class="product-description">
            <h2 class="product-section-title">Описание</h2>
            <p>@t.Description</p>
        </section>
    </div>
</article>

@if (Model.Related.Count > 0)
{
    <section class="related">
        <h2 class="related-title">Похожие телескопы</h2>
        <div class="related-grid">
            @foreach (var r in Model.Related)
            {
                <a class="related-card" asp-page="/Telescope" asp-route-id="@r.Id">
                    <div class="related-image">
                        <img asp-product-src="@r.Id"
                             alt="@r.Manufacturer"
                             loading="lazy" />
                    </div>
                    <div class="related-body">
                        <span class="related-manufacturer">@r.Manufacturer</span>
                        <span class="related-specs">@r.Aperture мм · f/@r.FocalLength мм</span>
                    </div>
                </a>
            }
        </div>
    </section>
}
